# Copy this file to .env.local and fill in your own values.
# Nothing here requires a credit card — both Supabase and Groq have
# genuinely free tiers you can sign up for with just an email.

# --- Supabase (free tier: https://supabase.com) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Groq (free tier: https://console.groq.com/keys) ---
# Groq gives free API access to open models (Llama 3.1/3.3, etc.) with
# no card on file. This is what actually "thinks" for Prism-AI.
GROQ_API_KEY=your-groq-api-key
# Any currently-supported Groq model id works; llama-3.3-70b-versatile
# is a good default balance of quality and speed as of writing.
GROQ_MODEL=
